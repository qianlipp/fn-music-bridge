YINQIAO_API_LISTEN=0.0.0.0:18090
YINQIAO_API_PREFIX=/yinqiao/v1

# The original trim.music service remains internal to the NAS.
YINQIAO_UPSTREAM_ORIGIN=http://unix
YINQIAO_UPSTREAM_API_BASE=/music/api/v1
YINQIAO_UPSTREAM_UNIX_SOCKET=/var/run/trim_music.socket

# The packaged LAN service deliberately has no Yinqiao API key.
YINQIAO_API_ALLOWED_ORIGINS=*

YINQIAO_API_PROXY_MUSIC_ROOT=false
YINQIAO_API_MAX_BODY_BYTES=33554432
YINQIAO_UPSTREAM_TIMEOUT_SECONDS=60

# Optional path/method overrides for a future upstream release.
# YINQIAO_UPSTREAM_ROUTE_MAP=/etc/fnmusic-api/routes.json
